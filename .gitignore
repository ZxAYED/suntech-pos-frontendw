# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/graphify-out/

# production
/build

# misc
.DS_Store
*.pem
*.zip

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# environment files
.env
.env.*
!.env.example

# next-pwa generated workers
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/swe-worker*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
branch_structure.json
temp_auto_push.bat
temp_interactive_push.bat
config.bat

# Generated offline build and automated test output (re-created by npm run build/tests)
/public/offline-assets/
/public/offline-build.json
/public/suntech-sw.js
/public/fonts/
/playwright-report/
/test-results/
/e2e/results/
