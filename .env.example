# NestJS backend origin (server-side only, no trailing path, no credentials)
BACKEND_API_URL=http://localhost:3000
SUNTECH_SESSION_SECRET=REPLACE_WITH_RANDOM_32_PLUS_BYTES_SECRET_DO_NOT_USE_DEFAULT
NEXT_PUBLIC_APP_NAME=Suntech POS
NEXT_PUBLIC_ALLOW_DEV_PREVIEW=false
# New local-first sale intake. Build-time switch: set false and rebuild to pause new sales.
# Existing receipts, sync retries and encrypted recovery remain available.
# Offline selling also requires the backend's approved grant lifetime and price policy.
NEXT_PUBLIC_OFFLINE_INTAKE=true

# Keep advanced offline intake disabled until qualified.
NEXT_PUBLIC_ADVANCED_OFFLINE_COMMANDS=false
